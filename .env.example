# Discord Botトークン（Developer Portalから取得）
DISCORD_TOKEN=your_token_here

# VOICEVOX EngineのURL（デフォルト: http://localhost:50021）
VOICEVOX_URL=http://localhost:50021

# デフォルト話者ID（VOICEVOXのスタイルID。例: 3）
DEFAULT_SPEAKER_ID=3

# 旧設定との互換用（未設定推奨）
# DEFAULT_SPEAKER_STYLE=normal

# 連投時のギルドごとのキュー上限
TTS_JOB_QUEUE_MAX_SIZE=100
AUDIO_QUEUE_MAX_SIZE=20

# ローテーション付きファイルログ（DockerではCompose側で設定済み）
# BOT_LOG_FILE=data/logs/voicebot.log
# BOT_LOG_MAX_BYTES=10485760
# BOT_LOG_BACKUP_COUNT=5
